# PYC SmartSMS — environment template
# Copy to .env on the server and edit BOTH values:
#   cp .env.example .env

# 1) Database — MUST be an ABSOLUTE path on that machine (SQLite file).
#    Example on a VPS where you cloned to /home/pyc/pyc-smartsms:
DATABASE_URL=file:/home/pyc/pyc-smartsms/db/custom.db

# 2) App secret — signs login cookies AND encrypts the SMS gateway API key.
#    Generate one with:  openssl rand -hex 32
#    ⚠️ Set it ONCE and never change it afterwards: changing it makes the
#    stored gateway API key undecryptable (you would re-enter the key in
#    Settings → SMS Provider after changing it).
APP_SECRET=change-me-to-a-long-random-hex-string
